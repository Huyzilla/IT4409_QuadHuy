# Google OAuth Client ID (Web application)
# Create in Google Cloud Console -> APIs & Services -> Credentials
VITE_GOOGLE_CLIENT_ID=

# Public backend origin (Render). Example:
# VITE_BACKEND_URL=https://traffic-backend.onrender.com
VITE_BACKEND_URL=

# API base URL (optional). If empty, app uses `${VITE_BACKEND_URL}/api`.
# Example: https://traffic-backend.onrender.com/api
VITE_API_BASE_URL=

# Socket.IO origin (optional). If empty, app uses VITE_BACKEND_URL.
# Example: https://traffic-backend.onrender.com
VITE_SOCKET_BASE_URL=

# Public HLS base URL for MediaMTX (must be https when FE is https).
# Example (ngrok): https://xxxx-yy-zz.ngrok-free.app
# Example (cloudflared): https://hls.yourdomain.com
VITE_HLS_BASE_URL=
