# Cấu hình Database (PostgreSQL chạy trên Docker port 5433 như trong docker-compose)
# docker-compose dùng: POSTGRES_USER=admin, POSTGRES_PASSWORD=admin123, POSTGRES_DB=traffic_ai
DATABASE_URL="postgresql://admin:admin123@localhost:5433/traffic_ai?schema=public"

# Cấu hình Redis (Chạy trên Docker port 6379)
REDIS_HOST="localhost"
REDIS_PORT=6379

# Cấu hình App
PORT=3000

# Cấu hình Auth
JWT_SECRET="dev_jwt_secret_change_me"

# SMTP (Gửi email OTP xác thực)
# Gmail:
# - SMTP_HOST=smtp.gmail.com
# - SMTP_PORT=587 (STARTTLS) + SMTP_SECURE=false
#   hoặc SMTP_PORT=465 (TLS) + SMTP_SECURE=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Lưu ý: SMTP_PASS là Google App Password (16 ký tự), không phải mật khẩu Gmail thường
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your_google_app_password_16_chars

# "From" nên khớp với SMTP_USER khi dùng Gmail SMTP
MAIL_FROM="Traffic Monitor <yourgmail@gmail.com>"